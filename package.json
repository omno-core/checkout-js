{
  "name": "@omno-payment/checkout-js",
  "version": "1.0.19",
  "description": "A framework-agnostic JavaScript SDK for payment processing with iframe integration",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "browser": "dist/index.umd.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "browser": "./dist/index.umd.js",
      "import": "./dist/index.esm.js",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rollup -c",
    "build:watch": "rollup -c -w",
    "dev:demo:build": "node esbuild.config.js",
    "dev:demo:serve": "live-server src/examples --open=html-example.html",
    "dev:demo": "concurrently \"npm run dev:demo:build\" \"npm run dev:demo:serve\"",
    "prepare": "npm run build",
    "lint": "eslint src --ext .ts",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "payment",
    "sdk",
    "javascript",
    "typescript",
    "iframe",
    "cashier",
    "checkout",
    "payments",
    "svelte",
    "react",
    "vue",
    "angular"
  ],
  "author": "Your Name",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/omno-core/checkout-js"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^28.0.6",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@rollup/plugin-replace": "^6.0.3",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^12.1.3",
    "concurrently": "^9.2.1",
    "live-server": "^1.2.2",
    "rollup": "^4.43.0",
    "rollup-plugin-dts": "^6.2.1",
    "typescript": "^5.8.3",
    "esbuild": "^0.27.2",
    "rollup-plugin-string-import": "^1.2.6"
  },
  "dependencies": {
    "tslib": "^2.8.1"
  }
}
